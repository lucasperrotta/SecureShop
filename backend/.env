# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=secureshop-dev-jwt-secret-key-minimum-32-characters!!
JWT_REFRESH_SECRET=secureshop-dev-refresh-secret-key-minimum-32-characters!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Configuration
ENCRYPTION_KEY=secureshop-dev-encryption-key-32ch!!
ENCRYPTION_SALT=secureshop-dev-salt-value-16ch!!

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secureshop
DB_USER=postgres
DB_PASSWORD=postgres

# Encryption key for pgcrypto (must match schema)
DB_ENCRYPTION_KEY=secureshop-dev-encryption-key-32ch!!
